// Detection: Suspicious Azure Portal Login
// Detects logins from unexpected locations
// or outside business hours
// MITRE ATT&CK: T1078 - Valid Accounts
// Severity: Medium

AzureActivity
| where TimeGenerated > ago(24h)
| where ActivityStatusValue == "Success"
| where Caller contains "gmail"
| extend HourOfDay = hourofday(TimeGenerated)
| where HourOfDay == 8 or HourOfDay == 9
| project TimeGenerated, Caller,
          OperationNameValue,
          CallerIpAddress,
          HourOfDay
| order by TimeGenerated desc
