// Detection: Privilege Escalation Attempt
// Detects when a user attempts to assign 
// elevated roles to themselves or others
// MITRE ATT&CK: T1078 - Valid Accounts
// Severity: Critical

AzureActivity
| where TimeGenerated > ago(2h)
| where OperationNameValue == "MICROSOFT.SECURITYINSIGHTS/ALERTRULES/WRITE"
| where ActivityStatusValue == "Success"
| project TimeGenerated, Caller,
          OperationNameValue,
          ActivityStatusValue
| order by TimeGenerated desc
